# CelebA Database Configuration Environment Template
# Copy this file to .env or export these variables in your deployment environment.

# Database Host & Port
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Restricted Application Service Account (Created via database/celeba_db_setup.sql Part 8)
MYSQL_USER=celeba_user
MYSQL_PASSWORD=celeba_pass_2026
MYSQL_DATABASE=celeba_db

# Local MySQL Server Binary Path (Optional override)
# MYSQL_BIN=D:\MySQL\bin\mysql.exe
