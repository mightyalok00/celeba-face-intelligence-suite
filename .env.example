# ==============================================================================
# CelebA Face Intelligence Suite - Environment Configuration Template
# Copy this file to .env or configure these variables in your deployment settings
# ==============================================================================

# Google AI Studio / Gemini API Key (Required for /api/analyze multimodal inference)
# Obtain an API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Application Server Port & Host Configuration
# Cloud runtimes (e.g. Google Cloud Run, AI Studio container) inject $PORT automatically
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# MySQL Relational Database (Optional - offline fallback is active when unavailable)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=celeba_user
MYSQL_PASSWORD=celeba_pass_2026
MYSQL_DATABASE=celeba_db
